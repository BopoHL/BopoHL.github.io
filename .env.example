# Public address of the site: canonical links, sitemap, Open Graph images.
NEXT_PUBLIC_SITE_URL=https://case404.example

# Where the typewriter posts statements: the contact Worker's URL with /contact
# (see server/contact/README.md). Leave empty to copy the statement and open Telegram instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# PostHog project key and ingestion host. Leave the key empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
